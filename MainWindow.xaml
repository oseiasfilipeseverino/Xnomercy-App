<Window x:Class="XnomercyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:XnomercyApp"
        mc:Ignorable="d"
        Title="XnoMercy" Height="800" Width="1280"
        Background="#131313"
        FontFamily="{StaticResource FontBody}"
        Closing="Window_Closing">

    <Window.Resources>
        <local:PctToWidthConverter x:Key="PctToWidth"/>
        <!-- Sobrescreve o hover/seleção branco padrão do Windows nas listas (Loot Log,
             Medidor de Dano etc.) por algo que combina com o tema escuro do app. -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#242424"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2e2e2e"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="NavBtn">
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BgFill" Grid.ColumnSpan="2" Background="Transparent"/>
                            <Border x:Name="Accent" Grid.Column="0" Background="Transparent"/>
                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="17,11,17,11"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgFill" Property="Background" Value="#222222"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" Value="#292213">
                                <Setter TargetName="BgFill" Property="Background" Value="#292213"/>
                                <Setter TargetName="Accent" Property="Background" Value="#c9a227"/>
                                <Setter Property="Foreground" Value="#DEFFFFFF"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Botão de abrir/fechar o menu lateral — diferente do NavBtn (que alinha à
             esquerda com padding grande): aqui o conteúdo fica centralizado, senão o
             "☰" ficava quase saindo da borda quando a barra estava fechada (coluna de
             só 48px de largura), parecendo cortado/torto. -->
        <Style TargetType="Button" x:Key="ToggleBtn">
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#242424"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Textura "cota de malha", a mesma do site (opcao B, 15/10): aneis
             entrelacados em dourado quase apagado sobre o fundo #131313. -->
        <DrawingBrush x:Key="FundoMalha" TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute" Viewbox="0,0,22,22" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#131313"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,22,22"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Geometry="M7.5,0 A7.5,7.5 0 0 1 0,7.5 M14.5,0 A7.5,7.5 0 0 0 22,7.5 M0,14.5 A7.5,7.5 0 0 1 7.5,22 M22,14.5 A7.5,7.5 0 0 0 14.5,22 M18.5,11 A7.5,7.5 0 1 1 3.5,11 A7.5,7.5 0 1 1 18.5,11 Z">
                        <GeometryDrawing.Pen><Pen Brush="#17c9a227" Thickness="1.4"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- Icones desenhados (traco), no lugar dos emojis: emoji muda de cara
             conforme a versao do Windows e nao segue a cor do tema. Grade 24x24. -->
        <Geometry x:Key="IcoFama">M12,2.5 L14.9,8.6 L21.5,9.3 L16.6,13.8 L18,20.4 L12,17 L6,20.4 L7.4,13.8 L2.5,9.3 L9.1,8.6 Z</Geometry>
        <Geometry x:Key="IcoLoot">M8,6 L21,6 M8,12 L21,12 M8,18 L21,18 M3,6 L4.5,6 M3,12 L4.5,12 M3,18 L4.5,18</Geometry>
        <Geometry x:Key="IcoEspadas">M14.5,17.5 L3,6 L3,3 L6,3 L17.5,14.5 M13,19 L19,13 M16,16 L20,20 M19,21 L21,19 M14.5,6.5 L18,3 L21,3 L21,6 L17.5,9.5 M5,14 L9,18 M7,17 L4,20 M3,19 L5,21</Geometry>
        <Geometry x:Key="IcoMartelo">M15,12 L6.5,20.5 A2.12,2.12 0 0 1 3.5,17.5 L12,9 M12,9 L15,12 M13,4 L20,11 L17.5,13.5 L10.5,6.5 Z</Geometry>
        <Geometry x:Key="IcoRelogio">M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 Z M12,7 L12,12 L15.5,14</Geometry>
        <Geometry x:Key="IcoCadeado">M5,11 L19,11 L19,21 L5,21 Z M8,11 L8,7.5 A4,4 0 0 1 16,7.5 L16,11 M12,15 L12,17</Geometry>
        <Geometry x:Key="IcoColeta">M14.5,3.5 C9,1.5 4.5,3 2.5,6 C6.5,5 10,6 12,8 M12,8 L20.5,20.5 M9.5,4.5 L19.5,14.5</Geometry>
        <Geometry x:Key="IcoGrupo">M9,11 A3.5,3.5 0 1 1 9,10.99 Z M2.5,20 C2.5,15.5 15.5,15.5 15.5,20 M17,10 A2.8,2.8 0 1 1 17,9.99 Z M16.5,14.2 C19.5,14 21.5,16 21.5,19</Geometry>
        <Geometry x:Key="IcoBau">M3,9 L21,9 L21,20 L3,20 Z M3,9 L5,4 L19,4 L21,9 M10,12 L14,12 L14,15 L10,15 Z</Geometry>
        <Geometry x:Key="IcoMapa">M3,6 L9,3.5 L15,6 L21,3.5 L21,18 L15,20.5 L9,18 L3,20.5 Z M9,3.5 L9,18 M15,6 L15,20.5</Geometry>
        <Geometry x:Key="IcoVendas">M3,6 L21,6 L19,14 L6,14 Z M6,14 L4.5,3.5 L2,3.5 M8,19 A1.5,1.5 0 1 1 8,18.99 Z M17,19 A1.5,1.5 0 1 1 17,18.99 Z</Geometry>
        <Geometry x:Key="IcoPino">M12,21.5 C12,21.5 5,15 5,9.5 A7,7 0 0 1 19,9.5 C19,15 12,21.5 12,21.5 Z M14,9.5 A2,2 0 1 1 10,9.5 A2,2 0 1 1 14,9.5 Z</Geometry>
        <Style x:Key="Ico" TargetType="Path">
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banner de atualização disponível (some por padrão) -->
        <Border x:Name="UpdateBanner" Grid.Row="0" Background="#1f5b2e" Visibility="Collapsed">
            <Grid Margin="16,8,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateBannerText" Grid.Column="0" Text="" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <Button x:Name="BtnUpdateDownload" Grid.Column="1" Content="Reiniciar e atualizar" Click="BtnUpdateDownload_Click"
                        Padding="12,5" Background="#1b1b1b" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="BtnUpdateDismiss" Grid.Column="2" Content="✕" Click="BtnUpdateDismiss_Click"
                        Padding="10,5" Margin="8,0,0,0" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu lateral (aparece só depois do login) -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="#1b1b1b" BorderBrush="#2b2b2b" BorderThickness="0,0,1,0" Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnToggleSidebar" DockPanel.Dock="Top" Content="☰" Click="ToggleSidebar_Click"
                        Style="{StaticResource ToggleBtn}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <StackPanel x:Name="SidebarTop" DockPanel.Dock="Top">
                    <TextBlock Text="XNOMERCY" Foreground="#c9a227" FontFamily="{StaticResource FontHead}" FontWeight="SemiBold" FontSize="28" Margin="20,6,20,12"/>
                    <Border Height="1" Margin="0,0,0,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#c9a227" Offset="0"/>
                                <GradientStop Color="#3a2c0d" Offset="0.55"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Button x:Name="NavFame" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="fame">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoFama}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,10,0" Opacity=".55"/><TextBlock Text="Fama &amp; Prata" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavLoot" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="loot">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoLoot}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,10,0" Opacity=".55"/><TextBlock Text="Loot Log" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavDamage" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="damage">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoEspadas}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,10,0" Opacity=".55"/><TextBlock Text="Medidor de Dano" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavCraft" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="craft">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoMartelo}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,10,0" Opacity=".55"/><TextBlock Text="Craft" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavGathering" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="gathering">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoColeta}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,10,0" Opacity=".55"/><TextBlock Text="Coleta" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavVendas" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="vendas">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoVendas}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,10,0" Opacity=".55"/><TextBlock Text="Vendas" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavGrupo" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="grupo">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoGrupo}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,10,0" Opacity=".55"/><TextBlock Text="Grupo (IP)" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavMapas" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="mapas">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoMapa}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,10,0" Opacity=".55"/><TextBlock Text="Mapas e Dungeons" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavBaus" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="baus">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoBau}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,10,0" Opacity=".55"/><TextBlock Text="Baús e Banco" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="NavSessions" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="sessions">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoRelogio}" Style="{StaticResource Ico}" Width="15" Height="15" Margin="0,0,10,0" Opacity=".55"/><TextBlock Text="Sessões" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="SidebarBottom" DockPanel.Dock="Bottom" Margin="22,0,22,18">
                    <!-- Captura acessível de qualquer aba, não só do Loot Log — pra não
                         precisar entrar lá só pra iniciar/pausar. -->
                    <Button x:Name="BtnCaptureToggle" Content="Iniciar captura" Click="BtnCaptureToggle_Click"
                            Padding="0,10" Background="#c9a227" Foreground="#111111" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Button x:Name="BtnPauseToggle" Content="Pausar" Click="BtnPauseToggle_Click"
                            Padding="0,7" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,8"/>
                    <Button x:Name="BtnOverlayToggle" Content="Overlay" Click="BtnOverlayToggle_Click"
                            Padding="0,7" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,8"
                            ToolTip="Mini painel flutuante com fama/prata por hora, sempre visível por cima do jogo"/>
                    <Button x:Name="BtnNetDiag" Content="Diagnóstico de rede" Click="BtnNetDiag_Click"
                            Padding="0,7" Background="#2e2e2e" Foreground="#c9a227" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,8"
                            ToolTip="Escuta 20s sem filtro de porta e mostra onde o tráfego do jogo realmente está. Use quando a captura não pegar nada (ex: com acelerador de rota tipo ExitLag). Pare a captura antes."/>
                    <Button x:Name="BtnSaudeCaptura" Content="Saúde da captura" Click="BtnSaudeCaptura_Click"
                            Padding="0,7" Background="#2e2e2e" Foreground="#c9a227" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,12"
                            ToolTip="Mostra, parte por parte (dano, loot, grupo, fama...), quando o app reconheceu cada evento pela última vez — e avisa se o jogo mudou algo num patch."/>
                    <Border Height="1" Margin="-6,0,-6,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2b2b2b" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Button x:Name="BtnLogout" Content="Sair" Click="BtnLogout_Click" HorizontalAlignment="Left"
                            Padding="0" Margin="0,0,0,10" Background="Transparent" Foreground="#8CFFFFFF" FontSize="13" Cursor="Hand" BorderThickness="0"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="CaptureDot" Width="9" Height="9" Fill="#57FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CaptureStateLabel" Text="Captura parada" Foreground="#8CFFFFFF" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtMapaAtual" Text="" Foreground="#8CFFFFFF" FontSize="12" Margin="17,4,0,0" TextTrimming="CharacterEllipsis"/>

                    <!-- Timer de fechamento de entrada de dungeon aleatória (90s) — visível
                         de qualquer aba, igual o indicador de captura acima. Some quando
                         você sai da dungeon. Ver DungeonTimerTracker.cs. -->
                    <Border x:Name="PanelDungeonTimer" Visibility="Collapsed" Background="#1a1208" CornerRadius="6"
                            Padding="10,8" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="ENTRADA DA DUNGEON FECHA EM" Foreground="#c9a227" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtDungeonTimer" Text="01:30" Foreground="White" FontFamily="{StaticResource FontHead}" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Column="1">
            <wv2:WebView2 x:Name="WebView" Visibility="Visible"/>

            <!-- Registro de energia da guild lido do jogo (18/10/2026): o oficial confere e
                 manda pro site com um clique. Ver MainWindow.Energia.cs. -->
            <Border x:Name="EnergiaBanner" Visibility="Collapsed" Panel.ZIndex="50" VerticalAlignment="Top"
                    HorizontalAlignment="Center" Margin="0,14,0,0" Padding="16,10" CornerRadius="8"
                    Background="#F21b1b1b" BorderBrush="#c9a227" BorderThickness="1" MaxWidth="720">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtEnergiaBanner" Foreground="White" FontSize="13" TextWrapping="Wrap"
                               VerticalAlignment="Center" MaxWidth="420" Margin="0,0,14,0"/>
                    <Button x:Name="BtnEnergiaEnviar" Content="Enviar ao site" Click="BtnEnergiaEnviar_Click"
                            Padding="14,6" Background="#c9a227" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnEnergiaIgnorar" Content="Ignorar" Click="BtnEnergiaIgnorar_Click"
                            Padding="12,6" Margin="8,0,0,0" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Marca enquanto a tela de login do site carrega (some no 1º carregamento) -->
            <Grid x:Name="LoginLoading" Background="{StaticResource FundoMalha}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="XNOMERCY" FontFamily="{StaticResource FontHead}" FontSize="46" Foreground="#c9a227" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtLoginLoadingStatus" Text="Carregando..." Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Pedido único de consentimento pro envio de diagnóstico (fase de teste).
                 Some pra sempre depois da 1ª resposta (ver ConsentStore). -->
            <Grid x:Name="PanelConsent" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="XNOMERCY" FontFamily="{StaticResource FontHead}" FontSize="30" Foreground="#c9a227" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Foreground="#DEFFFFFF" FontSize="14" Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Enquanto estamos testando, o app pode enviar erros e os eventos do Albion capturados (mesma informação do Loot Log / Medidor de Dano / Fama &amp; Prata) pro Discord da guild, pra ajudar a calibrar. Nada do seu sistema ou arquivos pessoais — só o que é do app e do jogo."/>
                    <TextBlock Foreground="#8CFFFFFF" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Só pergunta isso uma vez. Pode mudar de ideia depois falando com a liderança."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button x:Name="BtnConsentYes" Content="Aceitar" Click="BtnConsentYes_Click"
                                Padding="18,8" Background="#c9a227" Foreground="#111111" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnConsentNo" Content="Não aceitar" Click="BtnConsentNo_Click"
                                Padding="18,8" Margin="10,0,0,0" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelLoot" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="16,12,16,8">
                    <TextBlock Text="Loot Log" Foreground="#c9a227" FontFamily="{StaticResource FontHead}" FontSize="26" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <!-- Iniciar/Pausar captura agora fica no menu lateral, acima do "Sair"
                             — acessível de qualquer aba, não só daqui. -->
                        <TextBlock x:Name="TxtCaptureStatus" Text="Parado" Foreground="#8CFFFFFF" VerticalAlignment="Center"/>
                        <Button x:Name="BtnExportCsv" Content="Exportar CSV" Click="BtnExportCsv_Click"
                                Padding="14,6" Background="#242424" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="20,0,0,0"
                                ToolTip="Planilha simples pra abrir no Excel"/>
                        <Button x:Name="BtnExportLootLogger" Content="Exportar p/ Loot Logger" Click="BtnExportLootLogger_Click"
                                Padding="14,6" Background="#242424" Foreground="#c9a227" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                ToolTip="Formato aceito pelo AO Loot Logger Viewer (matheus.sampaio.us). Só inclui loot de JOGADOR — prata e saque de mob ficam fora, igual o logger original."/>
                        <Button x:Name="BtnMinhasPerdas" Content="Minhas perdas" Click="BtnMinhasPerdas_Click"
                                Padding="14,6" Background="#242424" Foreground="#f87171" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                ToolTip="O que pegaram do seu corpo quando você morreu, quem pegou e quanto valia"/>
                        <Button x:Name="BtnLootReset" Content="Reiniciar sessão" Click="BtnLootReset_Click"
                                Padding="14,6" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                        <ToggleButton x:Name="BtnAdvancedMode" Content="Modo avançado" Click="BtnAdvancedMode_Click"
                                      Padding="14,6" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="ChkHideMob" Content="Esconder saque de monstro" IsChecked="False" Click="LootFilter_Changed"
                                  Foreground="#DEFFFFFF" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkGuildOnlyLoot" Content="Só minha guild" IsChecked="False" Click="LootFilter_Changed"
                                  Foreground="#DEFFFFFF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <CheckBox x:Name="ChkPartyOnlyLoot" Content="Só meu grupo" IsChecked="False" Click="LootFilter_Changed"
                                  Foreground="#DEFFFFFF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBlock x:Name="TxtLootTotal" Text="" Foreground="#c9a227" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0,0,0"
                                   ToolTip="Soma do valor estimado dos itens que estão na lista agora (respeita os filtros). O valor vem do próprio jogo quando ele já mostrou o item; senão, do preço do mercado Americas."/>
                    </StackPanel>
                </StackPanel>

                <!-- Visão limpa (padrão): feed estilo chat "Fulano pegou X de Y" -->
                <ListView x:Name="ListCleanLoot" Grid.Row="1" Margin="16,0,16,16" Background="#1b1b1b" Foreground="White" BorderThickness="0" FontSize="13">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="#8a8a8a" FontSize="12"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <Image Grid.Column="1" Source="{Binding ItemIcon}" Width="22" Height="22"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,10,0"
                                           FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Looter, Mode=OneWay}" FontWeight="SemiBold" Foreground="#DEFFFFFF"/>
                                    <Run Text=" pegou " Foreground="#57FFFFFF"/>
                                    <Run Text="{Binding Item, Mode=OneWay}" Foreground="#c9a227"/>
                                    <Run Text=" de " Foreground="#57FFFFFF"/>
                                    <Run Text="{Binding From, Mode=OneWay}" Foreground="#57FFFFFF"/>
                                </TextBlock>
                                <TextBlock Grid.Column="3" Text="{Binding ValorTexto, Mode=OneWay}" ToolTip="{Binding ValorDica, Mode=OneWay}"
                                           Foreground="#c9a227" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Modo avançado (oculto por padrão): dados brutos pra depuração -->
                <Grid x:Name="PanelAdvanced" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" MaxHeight="220"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Foreground="#8CFFFFFF" FontSize="12" TextWrapping="Wrap"
                                   Text="Mostrando todos os eventos de rede decodificados, sem filtro. Clique no botão dourado bem na hora que pegar o item — os eventos próximos ficam fixos na caixa verde abaixo."/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="BtnMarkMoment" Click="BtnMarkMoment_Click"
                                    Padding="14,6" Background="#c9a227" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoPino}" Style="{StaticResource Ico}" Stroke="Black" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Marquei o momento!"/></StackPanel>
                            </Button>
                            <Button x:Name="BtnClearMarked" Content="Limpar marcados" Click="BtnClearMarked_Click"
                                    Padding="14,6" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#0d1f12" BorderBrush="#242424" BorderThickness="1" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,8,4"><Path Data="{StaticResource IcoPino}" Style="{StaticResource Ico}" Stroke="#4ade80" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Eventos marcados (candidatos a loot)" Foreground="#4ade80" FontWeight="Bold"/></StackPanel>
                            <ListView x:Name="ListMarkedEvents" Grid.Row="1" Background="Transparent" Foreground="White" BorderThickness="0" MaxHeight="180">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Hora" Width="100" DisplayMemberBinding="{Binding Time}"/>
                                        <GridViewColumn Header="Code" Width="60" DisplayMemberBinding="{Binding Code}"/>
                                        <GridViewColumn Header="Parâmetros" Width="900" DisplayMemberBinding="{Binding Summary}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <ListView x:Name="ListLootEvents" Grid.Row="2" Background="#1b1b1b" Foreground="White" BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNearMark}" Value="True">
                                        <Setter Property="Background" Value="#242424"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Hora" Width="100" DisplayMemberBinding="{Binding Time}"/>
                                <GridViewColumn Header="Code" Width="60" DisplayMemberBinding="{Binding Code}"/>
                                <GridViewColumn Header="Parâmetros" Width="900" DisplayMemberBinding="{Binding Summary}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Grid>

            <Grid x:Name="PanelDamage" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="16,12,16,8">
                    <TextBlock Text="Medidor de Dano — sessão atual" Foreground="#c9a227" FontFamily="{StaticResource FontHead}" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Foreground="#8CFFFFFF" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"
                               Text="Ranking de dano e cura por jogador, do que mais deu dano para o que menos deu. DPS conta só o tempo em que a pessoa estava batendo. A cura é a efetiva (passe o mouse para ver o overheal). O que sobrar como #número costuma ser mob ou invocação."/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnDamageReset" Content="Reiniciar sessão" Click="BtnDamageReset_Click"
                                Padding="14,6" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnDamageCopy" Content="Copiar medidor" Click="BtnDamageCopy_Click"
                                Padding="14,6" Background="#242424" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                        <Button x:Name="BtnDamageSave" Content="Salvar luta" Click="BtnDamageSave_Click"
                                Padding="14,6" Background="#242424" Foreground="#c9a227" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                ToolTip="Guarda o medidor como está, com o mapa e a hora. 'Reiniciar sessão' também guarda antes de zerar."/>
                        <Button x:Name="BtnLutasSalvas" Content="Lutas salvas" Click="BtnLutasSalvas_Click"
                                Padding="14,6" Background="#242424" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                        <Button x:Name="BtnDamageExport" Content="Exportar luta (CSV)" Click="BtnDamageExport_Click"
                                Padding="14,6" Background="#242424" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                                ToolTip="Salva o medidor como está na tela (dano, DPS, cura, recebido) num arquivo pra revisar a luta depois"/>
                        <CheckBox x:Name="ChkShowUnnamed" Content="Mostrar sem nome (#número)" IsChecked="False" Click="DamageFilter_Changed"
                                  Foreground="#DEFFFFFF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <CheckBox x:Name="ChkGuildOnlyDamage" Content="Só minha guild" IsChecked="False" Click="DamageFilter_Changed"
                                  Foreground="#DEFFFFFF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <CheckBox x:Name="ChkPartyOnlyDamage" Content="Só meu grupo" IsChecked="False" Click="DamageFilter_Changed"
                                  Foreground="#DEFFFFFF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="1" Margin="16,0,16,16">
                    <!-- Skill panel agora é overlay flutuante (Panel.ZIndex="10") -->
                    <ListView x:Name="ListDamage" Background="#1b1b1b" Foreground="White" BorderThickness="0"
                              SelectionChanged="ListDamage_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListDamageItem_PreviewMouseDown"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding WeaponIcon}" Width="30" Height="30"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Jogador" Width="200" DisplayMemberBinding="{Binding Player}"/>
                                <GridViewColumn Header="Dano" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Damage, StringFormat=N0}" FontFamily="{StaticResource FontHead}" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="% Dano" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Barra: estilo simples sem chrome do Windows (fundo escuro,
                                                     preenchimento dourado proporcional a DamagePctValue). -->
                                                <Border Grid.Column="0" Background="#242424" CornerRadius="3" Height="16" VerticalAlignment="Center">
                                                    <Border HorizontalAlignment="Left" Background="#c9a227" CornerRadius="3"
                                                            Width="{Binding DamagePctValue, Converter={StaticResource PctToWidth}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding DamagePct}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="DPS" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Dps, StringFormat=N0}" Foreground="#DEFFFFFF" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Cura" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Healing, StringFormat=N0}" ToolTip="{Binding HealingTip}" Foreground="#86efac" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Recebido" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Taken, StringFormat=N0}" Foreground="#f87171" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Skill panel: overlay flutuante no canto direito -->
                    <Border x:Name="PanelDamageBySkill"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="282" Panel.ZIndex="10"
                            Background="#161616" BorderBrush="#2a1a06" BorderThickness="1"
                            CornerRadius="4" Padding="12" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtDamageBySkillTitle" Grid.Row="0" Text="Dano por habilidade — selecione um jogador na lista"
                                       Foreground="#DEFFFFFF" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ListView x:Name="ListDamageBySkill" Grid.Row="1" Background="Transparent" Foreground="White" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Habilidade" Width="170" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Dano" Width="80" DisplayMemberBinding="{Binding Damage}"/>
                                        <GridViewColumn Header="%" Width="60" DisplayMemberBinding="{Binding DamagePct}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Mostrado quando a conta de teste não tem permissão pra essa aba -->
            <Grid x:Name="PanelBlocked" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                    <Path Data="{StaticResource IcoCadeado}" Style="{StaticResource Ico}" Stroke="#dc2626" StrokeThickness="2" Width="52" Height="52" HorizontalAlignment="Center"/>
                    <TextBlock Text="VOCÊ ESTÁ BLOQUEADO DE ACESSAR ESSA PARTE!" Foreground="#dc2626"
                               FontFamily="{StaticResource FontHead}" FontSize="30" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <TextBlock Text="Fale com a liderança da guild se precisar de acesso." Foreground="#8CFFFFFF"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelFame" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Fama &amp; Prata" Foreground="#c9a227" FontFamily="{StaticResource FontHead}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtFameSessionStart" Foreground="#8CFFFFFF" FontSize="12" Margin="0,4,0,16" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#1b1b1b" CornerRadius="6" Padding="30,22" MinWidth="180" Margin="0,0,12,0">
                            <StackPanel>
                                <Image Source="Icons/fame.png" Width="34" Height="34" HorizontalAlignment="Center"/>
                                <TextBlock Text="FAMA VERMELHA" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock x:Name="TxtFameTotal" Text="0" Foreground="#f87171" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtFamePerHour" Text="0/hora" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1b1b1b" CornerRadius="6" Padding="30,22" MinWidth="180" Margin="0,0,12,0">
                            <StackPanel>
                                <Image Source="Icons/yellow_fame.png" Width="34" Height="34" HorizontalAlignment="Center"/>
                                <TextBlock Text="FAMA AMARELA" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock x:Name="TxtYellowFameTotal" Text="—" Foreground="#fde047" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtYellowFamePerHour" Text="0/hora" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1b1b1b" CornerRadius="6" Padding="30,22" MinWidth="180" Margin="0,0,12,0">
                            <StackPanel>
                                <Image Source="Icons/silver.png" Width="34" Height="34" HorizontalAlignment="Center"/>
                                <TextBlock Text="PRATA" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock x:Name="TxtSilverTotal" Text="0" Foreground="#e2e8f0" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtSilverPerHour" Text="0/hora" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Mobs mortos em mundo aberto (Task #2) — ver OpenWorldKillTracker.cs.
                             Conta pelo evento MobKilled (166), já calibrado, filtrando pelo
                             nome de quem deu o último hit = você. -->
                        <Border Background="#1b1b1b" CornerRadius="6" Padding="30,22" MinWidth="180">
                            <StackPanel>
                                <Path Data="{StaticResource IcoEspadas}" Style="{StaticResource Ico}" Stroke="#86efac" Width="34" Height="34" HorizontalAlignment="Center"/>
                                <TextBlock Text="MOBS MORTOS" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock x:Name="TxtMobKillsTotal" Text="0" Foreground="#86efac" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtMobKillsPerHour" Text="0/hora" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtFaccao" Visibility="Collapsed" Foreground="#c9a227" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="756"/>
                    <Button x:Name="BtnFameReset" Content="Reiniciar sessão" Click="BtnFameReset_Click"
                            Padding="14,6" Margin="0,20,0,0" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"/>

                    <!-- Gráfico da sessão: evolução acumulada de fama e prata, amostrada
                         a cada minuto (ver _sessionSamples). Cada série é normalizada ao
                         próprio máximo — o formato mostra ONDE o farm rendeu, não compara
                         valor absoluto de fama contra prata. -->
                    <Border x:Name="PanelSessionChart" Background="#1b1b1b" CornerRadius="6" Width="756"
                            Margin="0,20,0,0" Padding="12,10" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="EVOLUÇÃO DA SESSÃO" Foreground="#8CFFFFFF" FontSize="12" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Rectangle Width="10" Height="3" Fill="#f87171" VerticalAlignment="Center"/>
                                    <TextBlock Text="Fama" Foreground="#8CFFFFFF" FontSize="12" Margin="4,0,10,0"/>
                                    <Rectangle Width="10" Height="3" Fill="#e2e8f0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Prata" Foreground="#8CFFFFFF" FontSize="12" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Canvas x:Name="SessionChartCanvas" Height="90" Width="416" ClipToBounds="True"/>
                            <TextBlock x:Name="TxtSessionChartHint" Text="" Foreground="#57FFFFFF" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Quebra de mobs mortos por tipo — só aparece depois do 1º kill. -->
                    <ListView x:Name="ListMobKills" Margin="0,20,0,0" MaxHeight="220" Width="756"
                              Background="#1b1b1b" Foreground="White" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Mob" Width="280" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Mortes" Width="80" DisplayMemberBinding="{Binding Kills}"/>
                                <GridViewColumn Header="/hora" Width="70" DisplayMemberBinding="{Binding KillsPerHour}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Grid>

            <!-- Histórico local de sessões (Task #8) — um resumo é gravado toda vez que
                 a captura é parada (ver SaveSessionToHistory em MainWindow.xaml.cs).
                 Só local (SessionHistoryStore.cs), nada é enviado pro servidor. -->
            <!-- Coleta (18/10/2026): o que VOCÊ coletou na sessão, por recurso.
                 Evento HarvestFinished (61) — ver Network/GatheringTracker.cs. -->
            <Grid x:Name="PanelGathering" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,20" Width="756">
                    <TextBlock Text="Coleta" Foreground="#c9a227" FontFamily="{StaticResource FontHead}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtColetaInicio" Foreground="#8CFFFFFF" FontSize="12" Margin="0,4,0,16" HorizontalAlignment="Center"
                               Text="Comece a coletar com a captura ligada — cada recurso que você pegar aparece aqui."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#1b1b1b" CornerRadius="6" Padding="30,22" MinWidth="180" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL COLETADO" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtColetaTotal" Text="0" Foreground="#e0c060" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtColetaHora" Text="0/hora" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1b1b1b" CornerRadius="6" Padding="30,22" MinWidth="180" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="DE BÔNUS" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtColetaBonus" Text="0" Foreground="#86efac" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtColetaBonusDet" Text="coletor + Premium" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1b1b1b" CornerRadius="6" Padding="30,22" MinWidth="180">
                            <StackPanel>
                                <TextBlock Text="COLETAS" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtColetaVezes" Text="0" Foreground="#e2e8f0" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="nós coletados" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ItemsControl x:Name="ListColeta" Margin="0,20,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1b1b1b" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icone}" Width="34" Height="34" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Nome}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detalhe}" Foreground="#8CFFFFFF" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Total}" Foreground="#e0c060" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="BtnColetaReset" Content="Reiniciar coleta" Click="BtnColetaReset_Click"
                            Padding="14,6" Margin="0,14,0,0" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Vendas (18/10/2026): o que você vendeu e comprou no mercado, pelas CARTAS
                 que o jogo manda. Ver Network/MarketMailTracker.cs. -->
            <!-- Baús e Banco (18/10/2026): o que tinha em cada aba do banco/baú que você abriu. Ver MainWindow.Baus.cs. -->
            <Grid x:Name="PanelBaus" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,20" Width="756">
                    <TextBlock Text="Baús e Banco" Foreground="#c9a227" FontFamily="{StaticResource FontHead}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Foreground="#8CFFFFFF" FontSize="12" Margin="0,4,0,12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="640"
                               Text="Cada aba do banco ou baú que você abre no jogo fica guardada aqui, com o que tinha dentro e o valor estimado. Dá pra conferir o banco de outra cidade sem ir até lá (mostra como estava na última vez que você abriu)."/>
                    <TextBlock x:Name="TxtBausResumo" Text="" Foreground="#c9a227" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="ListBaus">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1b1b1b" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detalhe}" Foreground="#8CFFFFFF" FontSize="12"/>
                                            <TextBlock Text="{Binding Itens}" Foreground="#DEFFFFFF" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Valor}" Foreground="#c9a227" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <Button Content="Esquecer" Tag="{Binding Guid}" Click="BtnBauEsquecer_Click" Margin="0,6,0,0"
                                                    Padding="10,3" Background="#2e2e2e" Foreground="#8CFFFFFF" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Grupo (18/10/2026): arma e IP de cada membro. Ver MainWindow.Grupo.cs / Network/GroupGear.cs. -->
            <Grid x:Name="PanelGrupo" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,20" Width="756">
                    <TextBlock Text="Grupo" Foreground="#c9a227" FontFamily="{StaticResource FontHead}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Foreground="#8CFFFFFF" FontSize="12" Margin="0,4,0,12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="640"
                               Text="Arma e IP do equipamento de cada pessoa do grupo, lidos do jogo quando ela está na sua tela. O IP do equipamento não conta qualidade nem maestria; o IP REAL aparece quando você inspeciona a pessoa no jogo."/>
                    <TextBlock x:Name="TxtGrupoResumo" Text="" Foreground="#c9a227" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="ListGrupo">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1b1b1b" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icone}" Width="34" Height="34" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Nome}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detalhe}" Foreground="#8CFFFFFF" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Ip}" Foreground="#c9a227" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding IpDica}" Foreground="#8CFFFFFF" FontSize="11" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Mapas e Dungeons (18/10/2026): visitas por zona e runs de dungeon. Ver MainWindow.Mapas.cs. -->
            <Grid x:Name="PanelMapas" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,20" Width="756">
                    <TextBlock Text="Mapas e Dungeons" Foreground="#c9a227" FontFamily="{StaticResource FontHead}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Foreground="#8CFFFFFF" FontSize="12" Margin="0,4,0,16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620"
                               Text="Cada zona em que você entra, com a fama, a prata, o loot que VOCÊ pegou e os mobs que você matou ali. Salas de dungeon seguidas viram uma run. Fica salvo entre as sessões."/>
                    <TextBlock Text="RUNS DE DUNGEON" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtRunsVazio" Text="Nenhuma run ainda — entre numa dungeon com a captura ligada." Foreground="#57FFFFFF" FontSize="12" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ListRuns">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1b1b1b" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Titulo}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detalhe}" Foreground="#8CFFFFFF" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Numeros}" Foreground="#c9a227" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="HISTÓRICO DE MAPAS" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" Margin="0,18,0,8"/>
                    <ItemsControl x:Name="ListMapas">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161616" CornerRadius="6" Padding="12,6" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Titulo}" Foreground="#DEFFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detalhe}" Foreground="#8CFFFFFF" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Numeros}" Foreground="#DEFFFFFF" FontSize="12" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="BtnMapasLimpar" Content="Limpar histórico" Click="BtnMapasLimpar_Click"
                            Padding="14,6" Margin="0,14,0,0" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"/>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="PanelVendas" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,20" Width="756">
                    <TextBlock Text="Vendas no mercado" Foreground="#c9a227" FontFamily="{StaticResource FontHead}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtVendasDica" Foreground="#8CFFFFFF" FontSize="12" Margin="0,4,0,16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="600"
                               Text="Compras e vendas na hora entram sozinhas. As que concluem depois (suas ordens) chegam por carta: abra a caixa de correio e as cartas no jogo."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#1b1b1b" CornerRadius="6" Padding="30,22" MinWidth="180" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="VENDIDO" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtVendido" Text="0" Foreground="#86efac" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="prata, antes da taxa" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1b1b1b" CornerRadius="6" Padding="30,22" MinWidth="180" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="COMPRADO" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtComprado" Text="0" Foreground="#f87171" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="prata" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1b1b1b" CornerRadius="6" Padding="30,22" MinWidth="180">
                            <StackPanel>
                                <TextBlock Text="SALDO" Foreground="#8CFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtSaldoVendas" Text="0" Foreground="#e0c060" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtCartasSemValor" Text="vendido − comprado" Foreground="#8CFFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ItemsControl x:Name="ListVendas" Margin="0,20,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1b1b1b" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icone}" Width="34" Height="34" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Nome}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detalhe}" Foreground="#8CFFFFFF" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Valor}" Foreground="{Binding Cor}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="BtnVendasReset" Content="Limpar" Click="BtnVendasReset_Click"
                            Padding="14,6" Margin="0,14,0,0" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"/>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="PanelSessions" Visibility="Collapsed" Background="{StaticResource FundoMalha}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="16,12,16,8">
                    <TextBlock Text="Histórico de Sessões" Foreground="#c9a227" FontFamily="{StaticResource FontHead}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Foreground="#8CFFFFFF" FontSize="12" Margin="0,4,0,0"
                               Text="Um resumo é salvo automaticamente sempre que você para a captura. Só fica salvo neste computador."/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnExportSessionsCsv" Content="Exportar CSV" Click="BtnExportSessionsCsv_Click"
                                Padding="14,6" Background="#242424" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnClearSessionHistory" Content="Limpar histórico" Click="BtnClearSessionHistory_Click"
                                Padding="14,6" Margin="8,0,0,0" Background="#2e2e2e" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <TextBlock x:Name="TxtSessionsStatus" Text="" Foreground="#8CFFFFFF" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <ListView x:Name="ListSessionHistory" Grid.Row="1" Margin="16,0,16,16" Background="#1b1b1b" Foreground="White" BorderThickness="0" FontSize="13">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Período" Width="200" DisplayMemberBinding="{Binding Period}"/>
                            <GridViewColumn Header="Duração" Width="90" DisplayMemberBinding="{Binding Duration}"/>
                            <GridViewColumn Header="Fama" Width="100" DisplayMemberBinding="{Binding Fame}"/>
                            <GridViewColumn Header="Fama Amarela" Width="110" DisplayMemberBinding="{Binding YellowFame}"/>
                            <GridViewColumn Header="Prata" Width="110" DisplayMemberBinding="{Binding Silver}"/>
                            <GridViewColumn Header="Dano" Width="100" DisplayMemberBinding="{Binding Damage}"/>
                            <GridViewColumn Header="DPS" Width="80" DisplayMemberBinding="{Binding Dps}"/>
                            <GridViewColumn Header="Itens de Loot" Width="100" DisplayMemberBinding="{Binding LootItems}"/>
                            <GridViewColumn Header="Valor do loot" Width="110" DisplayMemberBinding="{Binding LootValue}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
        </Grid>

        <!-- Ícone da bandeja do sistema -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                         ToolTipText="XnoMercy"
                         IconSource="icon.ico"
                         TrayMouseDoubleClick="TrayIcon_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Abrir" Click="TrayIcon_DoubleClick"/>
                    <MenuItem Header="Sair" Click="TrayMenu_Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
