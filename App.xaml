<Application x:Class="XnomercyApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XnomercyApp"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Identidade visual de 14/11/2026 (Identidade Visual XnoMercy/LEIA-ME), a mesma
             do site (pg_base.html :root). Preto Abismo #0A0707, Vermelho Cobra #D7261E,
             Ouro da Guarda #C8963E, Vermelho Escudo #8E0E10, Creme do Letreiro #E6D3AE.
             As superfícies clareiam com o CREME (quente), não com branco: bg2/bg3/bg4
             são as mesmas misturas do site (93/88/83% do fundo). Texto é creme com alfa.

             Fontes do kit: Oswald Bold (títulos), Barlow (texto), Barlow Condensed Bold
             (rótulos em maiúsculas). O "XnomercyApp;component" no caminho faz a fonte
             carregar também quando outra exe abre esta janela (os harness de teste);
             com "/Fonts/#X" ela procurava na exe que rodava e caía na Segoe UI. -->
        <FontFamily x:Key="FontHead">pack://application:,,,/XnomercyApp;component/Fonts/#Oswald</FontFamily>
        <FontFamily x:Key="FontBody">pack://application:,,,/XnomercyApp;component/Fonts/#Barlow</FontFamily>
        <FontFamily x:Key="FontLabel">pack://application:,,,/XnomercyApp;component/Fonts/#Barlow Condensed</FontFamily>

        <Color x:Key="CorFundo">#0A0707</Color>
        <SolidColorBrush x:Key="Fundo" Color="#0A0707"/>
        <SolidColorBrush x:Key="Fundo2" Color="#191513"/>
        <SolidColorBrush x:Key="Fundo3" Color="#241F1B"/>
        <SolidColorBrush x:Key="Fundo4" Color="#2F2A23"/>
        <SolidColorBrush x:Key="Borda" Color="#322C25"/>
        <SolidColorBrush x:Key="Ouro" Color="#C8963E"/>
        <SolidColorBrush x:Key="Ouro2" Color="#D2A961"/>
        <SolidColorBrush x:Key="Vermelho" Color="#D7261E"/>
        <SolidColorBrush x:Key="VermelhoTexto" Color="#E77D78"/>
        <SolidColorBrush x:Key="Escudo" Color="#8E0E10"/>
        <SolidColorBrush x:Key="Texto" Color="#F0E6D3AE"/>
        <SolidColorBrush x:Key="Texto2" Color="#ADE6D3AE"/>

        <!-- Fundo granulado do kit (textura-fundo-granulado.png, recomprimida em JPG):
             a mesma pele do site, no lugar da cota de malha de 15/10. 1024 px desenhados
             em 512 DIP pra ficar nítido em tela 200%. FlipXY e não Tile: a borda de
             cima da textura é mais clara que a de baixo e, repetida reta, deixava uma
             emenda horizontal no meio da tela; espelhada, borda encontra borda igual. -->
        <ImageBrush x:Key="FundoGranulado" ImageSource="pack://application:,,,/XnomercyApp;component/Icons/fundo-granulado.jpg"
                    TileMode="FlipXY" Stretch="Fill" Viewport="0,0,512,512" ViewportUnits="Absolute"/>

        <!-- Contorno de foco do teclado (Tab): o padrão do Windows é um pontilhado preto,
             invisível no fundo escuro. -->
        <Style x:Key="FocoTeclado">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" RadiusX="5" RadiusY="5" Stroke="#C8963E" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão padrão do app. Sem isto, o tema Aero2 do Windows pintava o botão de
             AZUL CLARO ao passar o mouse e ao clicar (com texto creme por cima, sumia),
             e o desabilitado ficava cinza-claro. Fundo e cor do texto continuam vindo de
             cada botão (Background/Foreground); aqui só entra a forma e os estados. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2F2A23"/>
            <Setter Property="Foreground" Value="#F0E6D3AE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                            <Border x:Name="Realce" Background="#E6D3AE" Opacity="0" CornerRadius="4"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Realce" Property="Opacity" Value=".08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Realce" Property="Opacity" Value=".16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mesmo desenho pro botão de liga/desliga ("Modo avançado"): ligado = borda
             e texto em ouro, pra dar pra ver o estado sem abrir nada. -->
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#2F2A23"/>
            <Setter Property="Foreground" Value="#F0E6D3AE"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Caixa" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                            <Border x:Name="Realce" Background="#E6D3AE" Opacity="0" CornerRadius="4"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Realce" Property="Opacity" Value=".08"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Caixa" Property="BorderBrush" Value="#C8963E"/>
                                <Setter TargetName="Caixa" Property="Background" Value="#271D0F"/>
                                <Setter Property="Foreground" Value="#D2A961"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de rolagem escura e fina. A do Windows é cinza-clara e era a coisa
             mais clara da tela nas listas longas (Loot Log, Lutas salvas). -->
        <Style x:Key="PolegarRolagem" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Pol" Background="#3A342C" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pol" Property="Background" Value="#5A4F40"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Pol" Property="Background" Value="#C8963E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrilhoRolagem" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#14100E">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrilhoRolagem}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PolegarRolagem}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrilhoRolagem}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="#14100E">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource TrilhoRolagem}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource PolegarRolagem}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource TrilhoRolagem}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cabeçalho de coluna do GridView (Loot Log, Medidor de Dano, Mobs mortos etc.):
             rótulo do kit = Barlow Condensed Bold em ouro. Sem este estilo vinha o tema
             branco do Windows. TargetType sem x:Key = vale pra TODO GridViewColumnHeader. -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#241F1B"/>
            <Setter Property="Foreground" Value="#C8963E"/>
            <Setter Property="FontFamily" Value="{StaticResource FontLabel}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#322C25"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linhas do ListView: fundo transparente, realce quente no mouse e ouro
             apagado na seleção (sem isso a seleção do Windows vinha azul). -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0E6D3AE"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#241F1B"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A2B15"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Checkbox dos filtros (Loot Log, Medidor de Dano): caixa escura com borda
             creme apagada, marca em ouro quando ligada. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0E6D3AE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Background="#241F1B" BorderBrush="#6BE6D3AE" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M2,7 L6,11 L13,3" Stroke="#C8963E" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#C8963E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#C8963E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
